# WASTEX environment configuration
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Never commit real credentials.

# Provider-neutral PostgreSQL connection URL used by the app and by drizzle-kit.
# Works with local PostgreSQL, Neon, Supabase, Amazon RDS, Azure, etc.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wastex"

# Optional: separate database used by the integration test suite.
# Leave unset to skip integration tests.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wastex_test"
